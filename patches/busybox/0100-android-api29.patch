+/* Bionic at API 29 has no GNU sigisemptyset(). Ignore unused padding. */
+static inline int bb_android_sigisemptyset(const sigset_t *set)
+{
+    int signal_number;
+    for (signal_number = 1; signal_number < NSIG; signal_number++)
+        if (sigismember(set, signal_number) == 1)
