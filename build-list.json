{
  "android_api": 29,
  "rust_toolchain": "1.99.1",
  "tools": {
    "ripgrep": {"binary": "rg", "description": "递归文本和正则搜索", "features": "Unicode、忽略规则、Rust 正则引擎", "homepage": "https://github.com/BurntSushi/ripgrep", "dependencies": ["ripgrep"]},
    "stress": {"binary": "stress", "description": "CPU、内存、I/O 和磁盘压力测试", "features": "经典 stress；附带对应源码", "homepage": "https://github.com/resurrecting-open-source-projects/stress", "dependencies": ["stress"]},
    "curl": {"binary": "curl", "description": "网络请求、下载和接口调试", "features": "HTTPS、HTTP/2、代理、gzip、内置 CA", "homepage": "https://curl.se/", "dependencies": ["curl", "openssl", "nghttp2", "zlib", "cacert"]},
    "jq": {"binary": "jq", "description": "JSON 查询、过滤和转换", "features": "内置 Oniguruma 正则引擎", "homepage": "https://jqlang.org/", "dependencies": ["jq"]},
    "iperf3": {"binary": "iperf3", "description": "TCP/UDP 网络吞吐测试", "features": "客户端、服务端、JSON；不启用可选身份认证", "homepage": "https://software.es.net/iperf/", "dependencies": ["iperf3"]},
    "zstd": {"binary": "zstd", "description": "Zstandard 压缩和解压", "features": "多线程、校验、字典；不附带其他格式压缩库", "homepage": "https://github.com/facebook/zstd", "dependencies": ["zstd"]},
    "sqlite3": {"binary": "sqlite3", "description": "SQLite 数据库命令行", "features": "FTS5、RTree、数学函数；禁用动态扩展加载", "homepage": "https://sqlite.org/cli.html", "dependencies": ["sqlite3"]},
    "socat": {"binary": "socat", "description": "网络转发和 socket 调试", "features": "TCP、UDP、Unix socket、OpenSSL；无 readline", "homepage": "https://github.com/dest-unreach/socat1", "dependencies": ["socat", "openssl"], "distribute_sources": true},
    "aria2": {"binary": "aria2c", "description": "多连接下载和任务管理", "features": "HTTP/HTTPS、FTP、BitTorrent、JSON-RPC；需指定 CA 文件；无 SFTP/Metalink", "homepage": "https://github.com/aria2/aria2", "dependencies": ["aria2", "openssl", "zlib", "cacert", "gpl3-license"], "distribute_sources": true},
    "tcpdump": {"binary": "tcpdump", "description": "网络抓包和 pcap 分析", "features": "内置静态 libpcap；实时抓包需要相应权限", "homepage": "https://www.tcpdump.org/", "dependencies": ["tcpdump", "libpcap"]},
    "strace": {"binary": "strace", "description": "系统调用和信号跟踪", "features": "跟踪受 ptrace/SELinux 限制；无 libdw 栈回溯及跨位数解码", "homepage": "https://strace.io/", "dependencies": ["strace"], "distribute_sources": true},
    "stress-ng": {"binary": "stress-ng", "description": "CPU、内存及内核压力测试", "features": "静态精简依赖；可用测试项取决于内核和权限", "homepage": "https://github.com/ColinIanKing/stress-ng", "dependencies": ["stress-ng"], "distribute_sources": true}
  },
  "architectures": {
    "arm64": {"abi": "arm64-v8a", "description": "主流 64 位 ARM 手机和平板", "clang": "aarch64-linux-android", "host": "aarch64-linux-android", "openssl": "android-arm64", "rust": "aarch64-linux-android", "qemu": "aarch64", "machine": 183, "elf_class": 2},
    "armv7": {"abi": "armeabi-v7a", "description": "32 位 ARM 设备", "clang": "armv7a-linux-androideabi", "host": "arm-linux-androideabi", "openssl": "android-arm", "rust": "armv7-linux-androideabi", "qemu": "arm", "machine": 40, "elf_class": 1},
    "x86_64": {"abi": "x86_64", "description": "64 位 x86 模拟器及设备", "clang": "x86_64-linux-android", "host": "x86_64-linux-android", "openssl": "android-x86_64", "rust": "x86_64-linux-android", "qemu": "x86_64", "machine": 62, "elf_class": 2},
    "x86": {"abi": "x86", "description": "32 位 x86 模拟器及设备", "clang": "i686-linux-android", "host": "i686-linux-android", "openssl": "android-x86", "rust": "i686-linux-android", "qemu": "i386", "machine": 3, "elf_class": 1}
  }
}
